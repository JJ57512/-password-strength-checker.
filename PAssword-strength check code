"""Password Strength Checker
Checks a password for length, uppercase, lowercase, numbers, and special
characters, then rates it Weak, Medium, or Strong and explains how to improve it.
"""

import string
from getpass import getpass


def check_password(password):
    """Return (score, list_of_tips) for the given password."""
    checks = [
        (len(password) >= 8, "Use at least 8 characters (12 or more is even better)."),
        (any(c.isupper() for c in password), "Add at least one uppercase letter (A-Z)."),
        (any(c.islower() for c in password), "Add at least one lowercase letter (a-z)."),
        (any(c.isdigit() for c in password), "Add at least one number (0-9)."),
        (any(c in string.punctuation for c in password),
         "Add at least one special character (e.g. ! @ # $ % ?)."),
    ]
    score = sum(1 for passed, _ in checks if passed)
    tips = [tip for passed, tip in checks if not passed]
    return score, tips


def rate(score, length):
    """Turn the score into a Weak / Medium / Strong rating."""
    if score <= 2:
        return "Weak"
    if score <= 4 or length < 12:
        return "Medium"
    return "Strong"


def main():
    print("=== Password Strength Checker ===")
    # getpass hides what you type; swap for input() if you want to see it
    password = getpass("Enter a password to check: ")

    if not password:
        print("You did not enter a password.")
        return

    score, tips = check_password(password)
    rating = rate(score, len(password))

    print(f"\nRequirements met: {score}/5")
    print(f"Strength rating: {rating}")

    if tips:
        print("\nHow to improve your password:")
        for tip in tips:
            print(f"  - {tip}")
        print("  - Avoid names, birthdays, and common words like 'password'.")
    else:
        print("\nGreat job! Your password meets every requirement.")
        if rating != "Strong":
            print("  - Make it 12+ characters to reach a Strong rating.")


if __name__ == "__main__":
    main()
